<Window
    x:Class="GScreen.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GScreen">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <TextBlock Text="GScreen" VerticalAlignment="Center" FontWeight="SemiBold"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Main column -->
            <ScrollViewer Padding="24,8,24,24">
                <StackPanel Spacing="16">
                    <InfoBar x:Name="Banner" IsOpen="False" IsClosable="True" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource ControlAltFillColorSecondaryBrush}" CornerRadius="8" Padding="3"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <ToggleButton x:Name="SplitMode" Content="Разделён на зоны" Click="OnSplitModeClick"
                                              CornerRadius="6" MinWidth="150" />
                                <ToggleButton x:Name="MergedMode" Content="Единый экран (игры)" Click="OnMergedModeClick"
                                              CornerRadius="6" MinWidth="150" />
                            </StackPanel>
                        </Border>
                        <ProgressRing x:Name="Busy" Grid.Column="1" IsActive="False" Width="20" Height="20"
                                      HorizontalAlignment="Left" Margin="8,0,0,0" />
                        <Button x:Name="ApplyButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                                Content="Применить раскладку" Click="OnApplyClick" />
                    </Grid>

                    <!-- 32:9 panel preview with draggable dividers -->
                    <StackPanel>
                        <Border x:Name="PanelFrame" Background="Black" CornerRadius="10,10,4,4" Padding="6"
                                BorderBrush="#2A2F3A" BorderThickness="2" SizeChanged="OnPanelSizeChanged">
                            <Grid x:Name="ZoneHost" />
                        </Border>
                        <Border Height="10" Width="140" HorizontalAlignment="Center" CornerRadius="0,0,6,6"
                                Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    </StackPanel>

                    <Grid x:Name="ZoneCards" ColumnSpacing="10" />

                    <TextBlock x:Name="StatusLine" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <!-- Side column -->
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0">
                <ScrollViewer Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Пресеты" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="PresetList" Spacing="6" />

                        <TextBlock Text="Частота виртуальных мониторов" Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Margin="0,8,0,0" />
                        <ComboBox x:Name="RefreshBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <x:String>240 Гц</x:String>
                            <x:String>165 Гц</x:String>
                            <x:String>144 Гц</x:String>
                            <x:String>120 Гц</x:String>
                            <x:String>60 Гц</x:String>
                        </ComboBox>

                        <TextBlock Text="Горячие клавиши" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                        <Grid RowSpacing="8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Зоны ⇄ единый экран" />
                            <TextBlock Grid.Column="1" Text="Ctrl+Alt+G" FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Grid.Row="1" Text="Пресет 1–4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ctrl+Alt+1…4" FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Grid.Row="2" Text="Окно → соседняя зона" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Win+Shift+←/→" FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Grid.Row="3" Text="Аварийный возврат" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Ctrl+Alt+Shift+R" FontFamily="{StaticResource MonoFont}" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="В OBS каждая зона — отдельный дисплей в «Захвате экрана». В Zoom и Teams можно показать одну зону. Разделительных линий нет специально: на OLED они выгорают." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
