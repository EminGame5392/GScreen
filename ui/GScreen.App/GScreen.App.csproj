<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>GScreen.App</RootNamespace>
    <AssemblyName>GScreen.App</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Unpackaged publish only ships GScreen.App.pri (compiled XAML) with MSIX tooling on;
         without it the window crashes in InitializeComponent. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Keep in sync with project(VERSION) in the root CMakeLists.txt. -->
    <Version>0.1.1</Version>
    <Product>GScreen</Product>
    <Company>GScreen contributors</Company>
    <Copyright>MIT License</Copyright>
    <AssemblyTitle>GScreen settings</AssemblyTitle>
    <!-- ProductVersion must be exactly "0.1.0" (SignPath checks it), not "0.1.0+<commit>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <!-- Belt and braces: fail the publish if the PRI did not make it. -->
  <Target Name="GScreenCheckPri" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="!Exists('$(PublishDir)$(TargetName).pri') And Exists('$(OutDir)$(TargetName).pri')" />
    <Error Text="$(TargetName).pri is missing from the publish folder" Condition="!Exists('$(PublishDir)$(TargetName).pri')" />
  </Target>
</Project>
